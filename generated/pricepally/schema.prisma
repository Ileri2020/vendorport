generator client {
  provider = "prisma-client-js"
  output   = "../generated/pricepally"
}

datasource db {
  provider = "mongodb"
  url      = env("PRICEPALLY_MONGODB_URL")
}

model PricepallyProduct {
  id           String   @id @map("_id")
  source       String
  sourceUrl    String
  sourceId     String   @unique
  handle       String?
  title        String?
  description  String?
  images       Json
  categoryRefs Json
  rawProduct   Json
  importedAt   DateTime
  createdAt    DateTime @default(now())

  @@index([handle])
  @@map("pricepally_products")
}

model PricepallyCategory {
  id          String   @id @map("_id")
  source      String
  sourceId    String?
  name        String
  handle      String
  productIds  String[]
  rawCategory Json
  importedAt  DateTime
  createdAt   DateTime @default(now())

  @@unique([handle])
  @@map("pricepally_categories")
}
