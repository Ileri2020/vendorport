// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mongodb"
  url          = env("MONGODB_URL")
  relationMode = "prisma"
}

model User {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  password      String?
  providerid    String?
  role          String            @default("customer") //professional admin staff supreme
  cart          Cart[]
  //orders   Order[]
  reviews       Review[]
  addresses     ShippingAddress[]
  post          Post[]
  notification  Notification[]
  image         String?           @default("https://res.cloudinary.com/dc5khnuiu/image/upload/v1752627019/uxokaq0djttd7gsslwj9.png")
  contact       String?           @default("xxxx-xxx-xxxx")
  // visit   Visit[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  wishlist      Wishlist[]
  messages      Message[]
  lunches       Lunch[]
  businesses    Business[]        @relation("UserBusinesses")
  chatThreads   ChatThread[]      @relation("UserChatThreads")
  priceFeedbacks PriceFeedback[]
  affiliate     Affiliate?
  heavilyDiscountedProducts HeavilyDiscountedProduct[]
}

model Business {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String            @unique // this will be the storeName for the slug /(storeName)
  description      String?          
  ownerId          String            @db.ObjectId
  owner            User              @relation("UserBusinesses", fields: [ownerId], references: [id])
  template         String            @default("estore") // estore, pharmacy, etc.
  ratings          Float             @default(0)
  numReviews       Int               @default(0)
  isArchived       Boolean           @default(false) // app owner can archive businesses
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  settings         ProjectSettings?
  siteSettings     SiteSettings?
  products         Product[]
  categories       Category[]
  staff            Staff[]
  carts            Cart[]
  coupons          Coupon[]
  deliveryFees     DeliveryFee[]
  messages         Message[]
  notifications    Notification[]
  posts            Post[]
  visits           Visit[]
  reviews          Review[]
  featuredProducts FeaturedProduct[]
  wishlists        Wishlist[]
  lunches          Lunch[]
  payments         Payment[]
  refunds          Refund[]
  promotions       Promotion[]
  subscribers      Subscriber[]
  stats            BusinessStat[]
  partners         Partner[]
  helpArticles     HelpArticle[]
  chatThreads      ChatThread[]      @relation("BusinessChatThreads")
}

model ProjectSettings {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId   String   @unique @db.ObjectId
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  currency     String   @default("NGN")
  exchangeRate Float    @default(1.0)
  // pages        Page[]
}



model Staff {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  role       String
  bio        String?
  image      String?
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId      String   @unique @db.ObjectId
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  aboutText       String   @default("Write about your business here")
  addToHome       String   @default("Add our app to your home screen for a better experience!")
  heroTitle       String   @default("Welcome to our store")
  heroSubtitle    String   @default("Browse our products and enjoy great deals")
  heroCTA         String?  @default("Shop Now")
  heroCTALink     String?  @default("/store")
  heroImage       String?
  logoImageUrl    String?
  iconMode        String   @default("text")
  iconText        String?
  iconFontSize    Int      @default(20)
  iconFontColor   String   @default("#000000")
  iconImageUrl    String?
  iconImageWidth  Int      @default(40)
  iconImageHeight Int      @default(40)
  contactDesc     String   @default("If you have any questions, inquiries, or would like to hire me, I would love to hear from you. Please feel free to reach out using the contact information provided below:")
  contactEmail    String?  @default("healthcliquespecialties@gmail.com")
  contactPhone    String?  @default("(+234) 816 968 4400")
  helpText        String   @default("How can we assist you?")
  facebook        String?
  instagram       String?
  twitter         String?
  linkedin        String?
  headerCTA       String?  @default("Join Now")
  footerText      String?  @default("Your trusted partner in quality products.")
  address         String?  @default("22 Akinagbe, Alapere, Ketu, Lagos State")
  newsletterTitle String?  @default("Join our Newsletter")
  newsletterText  String?  @default("Be the first to know about new arrivals and exclusive offers.")
  badgeText       String?  @default("NAFDAC Approved Pharmacy")
  preHeroText     String?  @default("With a click, get your")
  heroHighlight   String?  @default("Premium Medical Supplies")
  promoTitle      String?  @default("Order authentic medications, pharmaceutical products, and medical equipment at the lowest prices, delivered to your doorstep.")
  promoBannerText String?  @default("Authentic medical supplies at clearance prices. Limited quantities available — move fast!")
  animatedTexts   String[] @default(["Order authentic medications, pharmaceutical products, and medical equipment at the lowest prices, delivered to your doorstep.", "Authentic medical supplies at clearance prices. Limited quantities available — move fast!", "Fast delivery to your doorstep"]) 
  aboutSub        String   @default("We believe that access to safe, effective, and affordable medicines should never be a privilege—it should be a standard. We are a forward-thinking healthcare company dedicated to solving the complex challenges surrounding medicine access in Nigeria and across underserved African communities.")
  whoWeAreText    String   @default("Healthclique Limited is owned and managed by licensed Pharmacists with deep expertise in pharmaceutical care, supply chain management, and patient-centered service delivery. We operate in full compliance with all regulatory requirements governing the pharmaceutical sector, ensuring that every product and service we provide meets the highest standards of safety, quality, and authenticity.")
  visionText      String   @default("To become Africa’s most trusted digital healthcare platform, transforming how medicines are accessed and delivered—one community at a time.")
  promiseText     String   @default("From the moment you place an order to the time it arrives at your doorstep, we are committed to delivering a smooth, secure, and memorable experience. At Healthclique Limited, your health is not just our business—it is our purpose.")
  whatWeDoText    String   @default("We leverage a holistic, technology-driven approach to bridge the gap between patients, healthcare professionals, and essential medicines. Our robust platform is designed to serve:")
  aiSystemText    String   @default("With our advanced AI-powered system, accessing medications has never been easier. Simply upload your prescription or request, and our intelligent platform handles verification, sourcing, and fulfillment—delivering a seamless, stress-free experience from start to finish.")
  integrityText   String   @default("Integrity is the foundation of everything we do. Our mission aligns closely with the Nigerian National Drug Policy.")  
  accentLight     String   @default("8365 100% 37%")
  accentDark      String   @default("8365 100% 59%")
  accentSecondaryLight  String   @default("199 89% 48%")
  accentSecondaryDark   String   @default("199 89% 66%")
  accentForegroundLight String   @default("222 47% 12%")
  accentForegroundDark  String   @default("222 47% 10%")  
  bankName              String?  @default("")
  accountNumber         String?  @default("")
  accountName           String?  @default("")
  updatedAt       DateTime @updatedAt
}

model Promotion {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  image       String?
  discount    Float?
  startDate   DateTime?
  endDate     DateTime?
  businessId  String    @db.ObjectId
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subscriber {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  email      String
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([email, businessId])
}

model BusinessStat {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  label      String
  value      String
  icon       String?
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Partner {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  logo       String?
  website    String?
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model HelpArticle {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  title      String
  content    String
  category   String?
  businessId String   @db.ObjectId
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Account {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  userId            String @db.ObjectId
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  expires      DateTime
  sessionToken String   @unique
  accessToken  String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationRequest {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, token])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  code      String
  expires   DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}


model Post {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String?
  description String?
  url         String? // changed from contentUrl to match frontend
  type        String?   @default("image") // video, audio, image
  for         String? // e.g., "General", "Hospital", etc.
  event       String?
  author      User      @relation(fields: [authorId], references: [id])
  authorId    String    @db.ObjectId
  // product    Product?     @relation(fields: [productId], references: [id])
  // productId   String?  @db.ObjectId
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  businessId  String?   @db.ObjectId
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  username   String?
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?   @db.ObjectId
  email      String?
  message    String
  category   String?
  to         String?   @default("admin")
  from       String?   @default("admin")
  file       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String?   @db.ObjectId
}

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String // removed unique to allow same name in different businesses
  description String?
  image       String?
  //slug     String   @unique
  products    Product[]
  businessId  String?   @db.ObjectId
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, businessId])
}

model Product {
  id                String           @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  description       String?
  category          Category         @relation(fields: [categoryId], references: [id])
  categoryId        String           @db.ObjectId
  activeIngredients String[]
  scarce            Boolean?
  for               String[] //patients like oncology/cancer, hiv, etc
  brand             String?
  price             Float
  stock             Stock[] //@relation(fields: [stockId], references: [id])
  //stockId  String?   @db.ObjectId
  reviews           Review[]
  cartItems         CartItem[]
  Featured          FeaturedProduct?
  images            String[]
  costPrice         Float?
  //orderItems OrderItem[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  wishlist          Wishlist[]
  businessId        String?          @db.ObjectId
  business          Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  brandId           String?          @db.ObjectId
  brandData         Brand?           @relation(fields: [brandId], references: [id])
  activeIngredientIds String[]       @db.ObjectId
  activeIngredientRefs ActiveIngredient[] @relation(fields: [activeIngredientIds], references: [id])
  healthConcernIds  String[]         @db.ObjectId
  healthConcerns    HealthConcern[]  @relation(fields: [healthConcernIds], references: [id])
  vendors           ProductVendor[]
  priceFeedbacks    PriceFeedback[]
  heavilyDiscountedProducts HeavilyDiscountedProduct[]
  regulatoryClassification String?          @default("OTC")
  requiresPrescription     Boolean?         @default(false)
  weight                   String?
  bulkPrices               BulkPrice[]

  // add product features like dosage form, strength, manufacturer, etc
}

//for inputing available product, after sales, deduct the quantity
//one to one relationship with a product, notice the unique then objectid
model Brand {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String    @unique
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  version   Int       @default(0)

  @@index([order])
}

model Vendor {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  name      String            @unique
  address   String?
  products  ProductVendor[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  version   Int               @default(0)
}

model ProductVendor {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String   @db.ObjectId
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId        String   @db.ObjectId
  costPrice       Float
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productId, vendorId])
  @@index([productId])
  @@index([vendorId])
}

model ActiveIngredient {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String    @unique
  productIds       String[]  @db.ObjectId
  products         Product[] @relation(fields: [productIds], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model HealthConcern {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String    @unique
  productIds       String[]  @db.ObjectId
  products         Product[] @relation(fields: [productIds], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model PriceFeedback {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  feedback  String
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Affiliate {
  id            String               @id @default(auto()) @map("_id") @db.ObjectId
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String               @db.ObjectId @unique
  affiliateId   String               @unique
  name          String               @unique
  earnings      Float                @default(0.0)
  referrals     AffiliateReferral[]
  payouts       AffiliatePayout[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model AffiliateReferral {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  affiliate           Affiliate @relation(fields: [affiliateIdFk], references: [id], onDelete: Cascade)
  affiliateIdFk       String   @db.ObjectId
  referredUserId      String?  @db.ObjectId
  cartId              String?  @db.ObjectId
  orderId             String
  totalAmount         Float
  affiliateCommission Float
  referredBonus       Float
  status              String   @default("pending")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AffiliatePayout {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  affiliate     Affiliate @relation(fields: [affiliateIdFk], references: [id], onDelete: Cascade)
  affiliateIdFk String   @db.ObjectId
  amount        Float
  status        String   @default("requested")
  requestedAt   DateTime @default(now())
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Advertext {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeavilyDiscountedProduct {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  creator   User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String   @db.ObjectId
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  model     String
  operation String
  userId    String
  recordId  String
  changes   Json?
  timestamp DateTime @default(now())

  @@index([model, recordId])
  @@index([userId, timestamp])
  @@index([timestamp])
}

model Stock {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String   @db.ObjectId
  addedQuantity  Int
  costPerProduct Float?
  // pricePerProduct Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Cart {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String     @db.ObjectId
  name         String? // User given name for the cart
  contact      String? // Contact assigned to the cart
  products     CartItem[]
  total        Float
  deliveryFee  Float      @default(0)
  payment      Payment?
  status       String     @default("pending")
  refund       Refund?
  type         String     @default("cart") // cart, lunch
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deliveryDate DateTime?
  lunchId      String?    @db.ObjectId
  lunch        Lunch?     @relation(fields: [lunchId], references: [id], onDelete: SetNull)
  businessId   String?    @db.ObjectId
  business     Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String   @db.ObjectId
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  cart       Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId     String    @unique @db.ObjectId
  //method must be converted to an enum
  tx_ref     String?   @unique
  method     String
  amount     Float
  payeeName  String?
  receiptUrl String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  businessId String?   @db.ObjectId
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Coupon {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  code       String
  discount   Float?
  expiresAt  DateTime?
  businessId String?   @db.ObjectId
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([code, businessId])
}

model ShippingAddress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeliveryFee {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  country    String?
  state      String?
  city       String?
  region     String?
  price      Float
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  businessId String?   @db.ObjectId
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([country, state, city, region, businessId])
}

model Visit {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  fingerprint String // Browser fingerprint from localStorage
  visitDate   DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  businessId  String?   @db.ObjectId
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([fingerprint, visitDate, businessId])
  @@index([visitDate])
}

//one to one relation with cart, not d unique to avoid error
model Refund {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  cart       Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId     String    @unique @db.ObjectId
  amount     Float
  reason     String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String?   @db.ObjectId
}

model Message {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String    @db.ObjectId
  senderName    String
  senderEmail   String
  subject       String
  message       String
  adminResponse String?
  isSeen        Boolean   @default(false)
  isResolved    Boolean   @default(false)
  businessId    String?   @db.ObjectId
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model FeaturedProduct {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String    @unique @db.ObjectId
  businessId String?   @db.ObjectId
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Review {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @db.ObjectId
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String    @db.ObjectId
  rating     Int
  comment    String?
  isArchived Boolean   @default(false)
  reply      Boolean   @default(false)
  businessId String?   @db.ObjectId
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Lunch {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String?
  frequency  String    @default("once") // once, daily, weekly, monthly
  daysOfWeek String[] // ["monday", "wednesday"]
  timesInDay String[] // ["12:00", "15:00"]
  startDate  DateTime
  endDate    DateTime
  status     String    @default("active") // active, completed, cancelled
  carts      Cart[]
  businessId String?   @db.ObjectId
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Wishlist {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String    @db.ObjectId
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String    @db.ObjectId
  businessId String?   @db.ObjectId
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([userId, productId, businessId])
}

model ChatThread {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  user       User          @relation("UserChatThreads", fields: [userId], references: [id], onDelete: Cascade)
  userId     String        @db.ObjectId
  business   Business      @relation("BusinessChatThreads", fields: [businessId], references: [id], onDelete: Cascade)
  businessId String        @db.ObjectId
  messages   ChatMessage[]
  status     String        @default("active") // active, closed
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, businessId])
}

model ChatMessage {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId   String     @db.ObjectId
  sender     String // "user" or "admin"
  senderName String?
  message    String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([threadId, createdAt])
}

model BulkPrice {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  quantity  Int
  price     Float
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}
